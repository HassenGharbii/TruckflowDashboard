# Copy this file to .env and fill in real values once TruckFlowDB access is
# available. Never commit the real .env file.

# "simulator" (default, current dashboard behavior) or "truckflow"
DATA_SOURCE=simulator

# If this server runs on the SAME machine as Truckflow, "localhost" is fine.
# If it runs on a DIFFERENT machine, put the Truckflow machine's real IP or
# hostname here instead (localhost will NOT work remotely).
TRUCKFLOW_DB_HOST=localhost
TRUCKFLOW_DB_INSTANCE=PMSQLSERVER
# If the site firewall blocks SQL Browser (UDP 1434), ask for a static TCP
# port instead and set it here — TRUCKFLOW_DB_INSTANCE is then ignored.
TRUCKFLOW_DB_PORT=

TRUCKFLOW_DB_NAME=TruckFlowDB
# Use the dedicated read-only login created by
# server/scripts/windows-truckflow-setup-readonly-login.ps1 — NOT the app's
# own PMTruckflowUser account.
TRUCKFLOW_DB_USER=
TRUCKFLOW_DB_PASSWORD=

# Leave both at their defaults (true) unless the site DBA says otherwise.
TRUCKFLOW_DB_ENCRYPT=true
TRUCKFLOW_DB_TRUST_CERT=true
